#!/usr/bin/env bash
# Start the app natively (build if needed) 🎬
set -eu -o pipefail

source "$(dirname "$0")/env"

"$(dirname "$0")/compile"
mkdir -p "$RUNTIME_DIR"

nohup java -Dspring.profiles.active=dev \
  -jar target/studio1way-0.0.1-SNAPSHOT.jar \
  > "$RUNTIME_DIR/web.log" 2>&1 &
echo $! > "$RUNTIME_DIR/web.pid"

(cd frontend && nohup npm run start-dev \
  > "$RUNTIME_DIR/frontend.log" 2>&1 & echo $! > "$RUNTIME_DIR/frontend.pid")

"$(dirname "$0")/status"
echo "Check your logs with bin/native/logs"
