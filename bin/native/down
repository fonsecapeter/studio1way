#!/usr/bin/env bash
# Stop the native app 🛑
set -eu -o pipefail

source "$(dirname "$0")/env"

for name in web frontend; do
  pidfile="$RUNTIME_DIR/$name.pid"
  if [ -f "$pidfile" ]; then
    pid=$(cat "$pidfile")
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
    rm -f "$pidfile"
    echo "stopped $name (pid $pid)"
  fi
done
