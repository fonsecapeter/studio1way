type Mutation {
    createExperimentalProject(input: CreateExperimentalProjectInput!): ExperimentalProject
    createWoodWork(input: CreateWoodWorkInput!): WoodWork
}

input CreateExperimentalProjectInput {
    name: String!
    date: String!
    description: String!
    variety: String!
    id: ID
    video: ProjectVideoInput
    links: [ProjectLinkInput!]
    images: [ProjectImageInput!]!
}

input CreateWoodWorkInput {
    name: String!
    date: String!
    description: String!
    materials: String!
    finish: WoodWorkFinish!
    dimensions: Project3DimensionInput!
    id: ID
    links: [ProjectLinkInput!]
    images: [ProjectImageInput!]!
}

input Project3DimensionInput {
    height: Float!
    width: Float!
    depth: Float!
}

input ProjectVideoInput {
    src: String!
    aspectRatio: VideoAspectRatio!
}

input ProjectLinkInput {
    url: String!
    text: String!
}

input ProjectImageInput {
    sourcePath: String!
    name: String!
    alt: String!
    icon: Boolean
}

enum WoodWorkFinish {
    PASTE_WAX
    VARNISH
    ACRYLIC_PAINT_AND_PASTE_WAX
    TUNG_OIL
}

enum VideoAspectRatio {
    WIDE
    FULL
}
